{"schema_version":1,"guid":"xmly_track_498600770","apple_collection_id":"1645509141","show":"野草|鲁迅著","titel":"第一章 秋夜","audio":{"url":"https://jt.ximalaya.com//GKwRIRwF0VRhACpoXgETlnHD.m4a?channel=rss&album_id=56805835&track_id=498600770&uid=381381740&jt=https://aod.cos.tx.xmcdn.com/storages/d644-audiofreehighqps/A1/78/GKwRIRwF0VRhACpoXgETlnHD.m4a","user_agent":"PodcastsAM/1.0 (+https://amapps.app)","groesse":2779230,"format":"m4a","geprueft_am":"2026-08-27T20:31:44+00:00"},"faehigkeiten":{"clips":false,"range":true,"kapitel":true,"dynamik":"unbestimmt","grund":"M4A: Ausschnitte nur als AAC-Bloecke (clips_aac) - eine App ohne ADTS-Umverpackung zeigt keine","clips_aac":true},"einzeiler":"秋夜里后园两株枣树下的观察与深夜孤寂的思绪。","kurzfassung":"作者在秋夜的后园中观察到墙外的两株枣树及繁霜下的野花草。夜色渐深，枣树的干子直刺高空与月亮，夜游的鳄鸟飞过并伴随半夜的笑声。回到房内后，小飞虫撞击灯罩，作者点起纸烟静观这些小生灵。","stichpunkte":["后园墙外立着两株枣树，天空显得奇怪而高。","野花草在冷的夜气中瑟缩，做着关于春天的梦。","枣树落尽叶子和果实，单剩干子直刺天空与月亮。","夜半听到神秘的笑声，作者随即回到房内。","小飞虫从窗孔飞入，在灯罩上撞击并遭遇火焰。","灯罩上休息着小青虫，形态苍脆可爱。","作者打呵欠点起纸烟，对着灯光默默静点这些小生灵。"],"kapitel":[{"titel":"秋夜后园与枣树","start":0.62},{"titel":"深夜笑声与回房","start":212.4},{"titel":"灯火飞虫与静思","start":243.7}],"clips":[{"hook":"后园里奇怪而高的天空","start":3.019,"ende":27.864,"laenge":24.85,"byte_start":58258,"byte_ende":256669,"bytes":198412,"range_header":"bytes=58258-256669","vorlauf_s":0.0929,"inhalt_start":3.111,"anker_sha256":"0c9a579bed4fc4ee096ffd6eb0dfd02244ec47cf9987f60b6ba27ef4ac9dc583","anker_ende_sha256":"82fbfa0d99a0325677e21fe181d521b05021088bb34b54ede84981bb96888778","einblendung_ms":60,"text":"描述了从后园望出去，天空显得异常高远，仿佛要离开人间。","aac":{"profil":2,"samplerate_index":7,"kanaele":2,"bloecke":[335,332,331,346,357,353,368,350,363,354,404,401,374,362,355,356,377,370,425,360,331,345,348,353,357,376,339,358,384,345,364,352,348,360,370,364,360,374,368,369,386,375,365,364,424,405,392,442,428,347,355,343,353,347,352,359,372,350,365,386,384,372,343,360,364,374,383,383,396,343,349,344,381,372,377,385,432,364,358,365,359,364,371,373,376,390,343,367,376,388,384,386,434,342,358,374,388,41