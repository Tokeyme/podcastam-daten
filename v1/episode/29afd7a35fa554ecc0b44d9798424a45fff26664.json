      "inhalt_start": 95.496,
      "anker_sha256": "88ac0f2570f33e758735342ba737843a04521f265c4985426ec03a8767a7aeeb",
      "einblendung_ms": 60,
      "text": "敖拜进宫去,常常看到他们在御花园里摔跤。 还当康熙是小孩子,玩心重呢。 一天,康熙命敖拜进宫。 敖拜大摇大摆,入朝上。"
    },
    {
      "hook": "康熙当面质问鳌拜罪状，鳌拜自恃功高公然抗辩",
      "start": 124.056,
      "ende": 144.144,
      "laenge": 20.09,
      "byte_start": 3991352,
      "byte_ende": 4634167,
      "bytes": 642816,
      "range_header": "bytes=3991352-4634167",
