{"schema_version":1,"guid":"https://aod.cos.tx.xmcdn.com/storages/61b3-audiofreehighqps/AA/CC/CKwRIMAER4WHABJbOgCdBDhC.m4a","apple_collection_id":"1562546156","show":"育儿知识：新生婴儿吐奶怎么办","titel":"01、怎么预防一个月宝宝吐奶，吐奶的处理办法","audio":{"url":"https://jt.ximalaya.com//CKwRIMAER4WHABJbOgCdBDhC.m4a?channel=rss&album_id=48485453&track_id=404316031&uid=135370948&jt=https://aod.cos.tx.xmcdn.com/storages/61b3-audiofreehighqps/AA/CC/CKwRIMAER4WHABJbOgCdBDhC.m4a","user_agent":"PodcastsAM/1.0 (+https://amapps.app)","groesse":1203002,"format":"m4a","geprueft_am":"2026-08-27T11:29:58+00:00"},"faehigkeiten":{"clips":false,"range":true,"kapitel":true,"dynamik":"unbestimmt","grund":"M4A: Ausschnitte nur als AAC-Bloecke (clips_aac) - eine App ohne ADTS-Umverpackung zeigt keine","clips_aac":true},"einzeiler":"探讨一个月大婴儿吐奶的预防与科学处理方法","kurzfassung":"本期节目介绍了针对一个月大婴儿吐奶现象的科学预防与处理方法。主要措施包括帮助宝宝拍嗝、改善喂奶姿势以及控制喂奶量。此外，还需要注意保护宝宝的腹部以防受凉。","stichpunkte":["竖抱宝宝并轻轻拍打后背五分钟以上是基本的拍嗝方法","如果宝宝无法打嗝，可以用手掌按摩后背","可让宝宝坐起来或趴在腿上轻拍后背来帮助拍嗝","喂奶时避免让宝宝躺着吸奶以防奶水反流引发吐奶","建议将宝宝揽在怀里喂奶，且头部要比身体高一些","喂奶后应将宝宝竖起来并从脊椎中部往上轻轻拍背","控制每次喂奶量，做到每次少喂、多喂几次","注意保护宝宝的肚子以免受凉引发肠胃痉挛导致吐奶"],"kapitel":[{"titel":"预防和处理吐奶的方法","start":1.68},{"titel":"应对吐奶的具体措施","start":60.94}],"clips":[{"hook":"如何通过拍嗝预防吐奶","start":19.923,"ende":40.078,"laenge":20.15,"byte_start":174827,"byte_ende":335869,"bytes":161043,"range_header":"bytes=174827-335869","vorlauf_s":0.0929,"inhalt_start":20.016,"anker_sha256":"3684618d7982721253be244dd614dffe439440da963a02d015186f2c96267c77","anker_ende_sha256":"2ef912493ac412e7f3553305adb5f140ac69fa18fc227d5e84e112546a31875e","einblendung_ms":60,"text":"介绍竖抱并轻拍背部超过五分钟作为防止吐奶的基础手段。","aac":{"profil":2,"samplerate_index":7,"kanaele":2,"bloecke":[416,385,364,347,352,333,363,449,442,311,306,329,359,433,395,323,329,366,397,342,329,364,391,341,356,354,368,347,357,372,387,371,362,401,413,352,346,348,351,370,419,559,333,343,423,397,458,382,311,310,355,427,408,360,389,340,334,333,329,374,403,511,314,335,337,411,317,446,410,417,300,327,321,365,357,348