354,374,378,357,356,373]}}],"erzeugt":{"am":"2026-08-29T20:35:24+00:00","transkript_modell":"faster-whisper large-v3","transkript_quelle":"whisper","verstehen_modell":"gemini-flash-lite-latest","prompt_version":2},"sprache":"zh","texte_sprache":"zh","texte_herkunft":"erzeugt","dauer":568,"veroeffentlicht":"2026-01-28T04:50:47+00:00","beschreibung":"本播客聚焦百岁高僧梦参法师的传奇一生与智慧法门。法师早年弃武出家，入藏研习密法，却因坚守弘法初心蒙冤入狱三十三载，凭 “不退菩提心” 誓言挺过磨难，将牢狱化作心性熔炉。他深耕地藏法门，圆满讲解《地藏三经》，融《华严经》义理于日常，法语平实却直击本质，以宽容慈悲待人。百岁生涯中，他九十高龄仍登台讲经数小时，教世人顺境不耽乐、逆境不丧志，以觉悟守本心、以愿力对生活。聆听法师故事，习得浮躁尘世中安身立命的智慧，传承慈悲坚守的精神内核。","bild_url":"https://fdfs.xmcdn.com/storages/c127-audiofreehighqps/82/16/GKwRIJENSm2FAA6k2ARfEOqd.jpeg","folgennummer":1,"kapitel_quelle":"modell"}