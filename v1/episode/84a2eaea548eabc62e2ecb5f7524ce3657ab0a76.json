{"schema_version":1,"guid":"https://aod.cos.tx.xmcdn.com/group60/M07/00/76/wKgLb1ztar6zZRUJACI9a3O7DiQ358.m4a","apple_collection_id":"1755468355","show":"尼尔斯骑鹅旅行记","titel":"骑鹅旅行记-7","audio":{"url":"https://jt.ximalaya.com//wKgLb1ztar6zZRUJACI9a3O7DiQ358.m4a?channel=rss&album_id=23537600&track_id=187238795&uid=97409896&jt=https://aod.cos.tx.xmcdn.com/group60/M07/00/76/wKgLb1ztar6zZRUJACI9a3O7DiQ358.m4a","user_agent":"PodcastsAM/1.0 (+https://amapps.app)","groesse":2243947,"format":"m4a","geprueft_am":"2026-08-27T18:13:09+00:00"},"faehigkeiten":{"clips":false,"range":true,"kapitel":true,"dynamik":"unbestimmt","grund":"M4A: Ausschnitte nur als AAC-Bloecke (clips_aac) - eine App ohne ADTS-Umverpackung zeigt keine","clips_aac":true},"einzeiler":"尼尔斯智斗狐狸斯密兰，最终回到家中并变回人形。","kurzfassung":"尼尔斯利用大狗成功抓住了狐狸斯密兰，随后与大雁群一起继续飞行并经历趣事。第二年大雁返程时尼尔斯回到家中，在小鹅的帮助下变回了人形。大聂老师总结了尼尔斯的成长历程，并祝愿同学们健康成长。","stichpunkte":["尼尔斯机智地用狗链将狐狸斯密兰绑在狗舍里","大雁群返回并对尼尔斯的智举表示高兴和赞赏","尼尔斯跟随大雁群飞行并经历了许多有趣的事情","第二年大雁返回北方，尼尔斯回到了自己的家门口","在一只小鹅自愿变成拇指后，尼尔斯成功变回人形","尼尔斯的母亲看到他回家感到非常惊喜","大聂老师建议同学们长大后阅读原著以获得更多乐趣","老师寄语同学们能在成长中变得勇敢、有爱心并承担责任"],"kapitel":[{"titel":"抓获狐狸与重返雁群","start":1.82},{"titel":"尼尔斯回家并变回人形","start":115.2},{"titel":"故事总结与寄语","start":175.16}],"clips":[{"hook":"狐狸被大狗抓住了","start":30.0,"ende":56.366,"laenge":26.37,"byte_start":284182,"byte_ende":494887,"bytes":210706,"range_header":"bytes=284182-494887","vorlauf_s":0.0812,"inhalt_start":30.081,"anker_sha256":"11e615a2cc7b7d5623be7a4478e17192406f8fe4b165ddfa1746427906a217b1","anker_ende_sha256":"1d3618fac5052f86f0382dd7b2867e75196d1e14af03a953b5a496f2691aeae9","einblendung_ms":60,"text":"狐狸企图利用乌鸦抓住主角，但主角机智地躲进狗舍并借助大狗的力量反将狐狸擒获。","aac":{"profil":2,"samplerate_index":7,"kanaele":2,"bloecke":[360,380,391,327,324,339,380,363,348,353,359,343,348,356,392,353,350,362,333,352,359,356,347,348,356,365,356,406,356,367,350,447,359,353,345,359,356,411,346,352,358,361,363,369,388,402,421,447,451,427,412,420,400,403,405,398,388,379,373,347,333,371,374,361,353,343,340,344,326,338,340,3